# ALEX reads secrets from this file. Copy to .env and fill in only what you use.
# None of these are required. With no keys, ALEX runs on the offline kernel.
# With Ollama installed, set ALEX_PROVIDER=ollama and leave the keys blank.

# --- Language models (use one, or several and switch in Settings) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# xAI Grok: https://console.x.ai/
XAI_API_KEY=
# Local Ollama. Install: https://ollama.com/download/windows
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Initial provider: offline | openai | anthropic | xai | ollama
# The choice in Settings is saved in the database and overrides this after first launch.
ALEX_PROVIDER=offline
ALEX_MODEL=

# --- Voice (optional) ---
# OpenAI Whisper + TTS use OPENAI_API_KEY above.
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice id from your ElevenLabs voice library (not the API key).
ELEVENLABS_VOICE_ID=

# --- Web search (optional, either one) ---
# Tavily: https://tavily.com
TAVILY_API_KEY=
# Brave Search API: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# --- Process ---
ALEX_HOST=127.0.0.1
ALEX_PORT=8787
# Leave this unset. Keys, the database, memories, and projects then live outside
# this folder: %LOCALAPPDATA%\ALEX on Windows, ~/.local/share/alex on Linux.
# Set it only if you want a different folder.
# ALEX_DATA_DIR=
# Set to 1 to stop start.py from opening a browser window.
ALEX_NO_BROWSER=

# One-click updates. BelsonXD/alex is the default repository. Set this only to use another one.
# The latest GitHub release must include an asset named alex.zip.
# ALEX_GITHUB_REPO=BelsonXD/alex
# Private repo: a fine-grained token with Contents: Read only.
# ALEX_UPDATE_TOKEN=
# Or a JSON manifest: {"version","zip_url","sha256","notes"}
# ALEX_UPDATE_MANIFEST=
